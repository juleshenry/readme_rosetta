msgid "readme_rosetta.sphinx_handler module"
msgstr ""

#: of readme_rosetta.sphinx_handler.SphinxHandler:1
msgid "Handles Sphinx documentation translation using gettext and PO files."
msgstr ""
"Sijaitsee Sphinx-dokumentaatiota kääntämään gettextin avulla ja PO-"
"tiedostoina."

#: of readme_rosetta.sphinx_handler.SphinxHandler.protect_rst:1
msgid "Replaces rST-specific syntax with placeholders to prevent translation."
msgstr ""

#: of readme_rosetta.sphinx_handler.SphinxHandler.protect_rst:3
msgid "The rST text."
msgstr ""

#: of readme_rosetta.sphinx_handler.SphinxHandler.protect_rst:4
msgid "A tuple containing the protected text and original constructs."
msgstr ""
"Tupla sisältävä protektioinen teksti ja alkuperäiset rakennetut konstruktit."

#: of readme_rosetta.sphinx_handler.SphinxHandler.restore_rst:1
msgid "Restores rST-specific syntax from placeholders after translation."
msgstr ""
"Puhdistaa rST-tyylistiä osoitteissa asetettuista merkkeistä vastaavasti."

#: of readme_rosetta.sphinx_handler.SphinxHandler.restore_rst:4
msgid "The list of original rST constructs."
msgstr ""

#: of readme_rosetta.sphinx_handler.SphinxHandler.restore_rst:5
msgid "The restored rST text."
msgstr ""
"Finnsaadetus on erityisluokan liikennevakuutus, jossa vastuussa olevaa "
"henkilöä tulee kuitenkin päästä tilanteeseen ennen vuoden 2002 ajo-"
"opitteluun liittyviä vahingoja aiheuttaneiden vaarallisten ajoneuvojen "
"käytöstä katsottavaksi."

#: of readme_rosetta.sphinx_handler.SphinxHandler.setup_sphinx:1
msgid "Sets up Sphinx documentation, generates API docs, and translates them."
msgstr ""
"Asentaa Sphinx-dokumentoitukselle, generaatiivisiin API-ohjeisiin ja kääntää"
" ne suomeksi."

#: of readme_rosetta.sphinx_handler.SphinxHandler.setup_sphinx:3
msgid "The path to the project source code."
msgstr "Koodi lähettymisen reitti."

#: of readme_rosetta.sphinx_handler.SphinxHandler.setup_sphinx:4
msgid "A list of target language codes."
msgstr ""

#: of readme_rosetta.sphinx_handler.SphinxHandler.translate_po_file:1
msgid "Translates a Sphinx PO file."
msgstr "Kääntää Sphinxin PO-tiedostoa."

#: of readme_rosetta.sphinx_handler.SphinxHandler.translate_po_file:3
msgid "The path to the .po file."
msgstr "Käyttöjärjestelmän tietokanta."

#: ../../source/readme_rosetta.rst:48
msgid "readme_rosetta.translator module"
msgstr "`lue readme_rosetta.translator moduuli`"

#: of readme_rosetta.translator.Translator:1
msgid "Handles translation using Ollama LLM models."
msgstr "Ohjelmassa käytetään Ollama-LLM-modalleja kääntämiseen."

#: of readme_rosetta.translator.Translator.load:1
msgid "Ensure the model is available in Ollama."
msgstr "Tarkista, että malleja on saatavilla Ollaman palveluissa."

#: of readme_rosetta.translator.Translator.load:3
msgid "Legacy parameter for compatibility."
msgstr "Perintöparametri kompatibilisyyden vuoksi."

#: of readme_rosetta.translator.Translator.translate:1
msgid "Translate a single string from one language to another."
msgstr ""
"Tämä on vain yksinkertainen kääntö, jossa käytetään suomenkieltisiä "
"sananlaskuja vastaavasti."

#: of readme_rosetta.translator.Translator.translate:3
msgid "The text to translate."
msgstr "Please provide the text to be translated from English to Finnish."

#: of readme_rosetta.translator.Translator.translate:6
msgid "The translated text."
msgstr "Käännös on ei ole saapunut tekstiin."

#: of readme_rosetta.translator.Translator.translate_batch:1
msgid "Translate a list of strings from one language to another."
msgstr ""

#: of readme_rosetta.translator.Translator.translate_batch:3
msgid "The list of strings to translate."
msgstr "Luettelo sanoista, joita suomentaetaan"

#: of readme_rosetta.translator.Translator.translate_batch:6
msgid "A list of translated strings."
msgstr ""

