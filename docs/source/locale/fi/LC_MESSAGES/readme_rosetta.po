#: ../../source/readme_rosetta.rst:24
msgid "readme_rosetta.markdown_handler module"
msgstr ""
"Markkinointi- ja konsultointipalvelujen rosketti markkinointiautomaattissa"

#: of readme_rosetta.markdown_handler.MarkdownHandler:1
msgid "Handles parsing and translation of Markdown files."
msgstr ""
"Käsittää parsiamentin ja kääntämisen Markdow-niin liittyvät toimintaa."

#: of readme_rosetta.markdown_handler.MarkdownHandler.clean_header_for_link:1
msgid "Cleans a Markdown header to be used as an anchor link."
msgstr ""
"Puhdistaa Markiadinen tiedostokuvaan, joka voidaan käyttää lyhennettynä "
"linkkilähettänä."

#: of readme_rosetta.markdown_handler.MarkdownHandler.clean_header_for_link:3
msgid "The header text."
msgstr "Ylävartalo"

#: ../../source/readme_rosetta.rst
msgid "Returns"
msgstr "Palautetaan"

#: of readme_rosetta.markdown_handler.MarkdownHandler.clean_header_for_link:4
msgid "The cleaned header link (e.g., \"#my-header\")."
msgstr "Linkki puhdistettu ylätiedotaulukko (#my-header)."

#: of readme_rosetta.markdown_handler.MarkdownHandler.discover_translations:1
msgid "Scans the directory for existing translated README files."
msgstr ""
"Tarkastelee ohjelmistopalvelun olemassa olevia käännösreadme-faaseja "
"käytännössä tiedostojen paikalla olevissa tiedostosijainneissa."

#: of readme_rosetta.markdown_handler.MarkdownHandler.discover_translations:3
msgid "Path to the main README file."
msgstr "Sisällyste main README tiedostoon"

#: of readme_rosetta.markdown_handler.MarkdownHandler.discover_translations:4
msgid "List of language codes found."
msgstr ""

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:1
msgid "Generates or updates the Rosetta translation table in the README."
msgstr ""
"Päättää rosettataulukon generoimisen tai päivittämisen lueen tiedoston "
"sisältöä."

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:3
msgid "The first header of the document."
msgstr "Esituoteen perusteet"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:4
#: readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:4
#: readme_rosetta.sphinx_handler.SphinxHandler.setup_sphinx:5
#: readme_rosetta.sphinx_handler.SphinxHandler.translate_po_file:4
#: readme_rosetta.translator.Translator.translate:4
#: readme_rosetta.translator.Translator.translate_batch:4
msgid "The source language code."
msgstr "`en`"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:5
#: readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:5
#: readme_rosetta.sphinx_handler.SphinxHandler.translate_po_file:5
#: readme_rosetta.translator.Translator.translate:5
#: readme_rosetta.translator.Translator.translate_batch:5
msgid "The target language code."
msgstr "Kieliä: englanti → suomi"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:6
msgid "The existing Rosetta table, if any."
msgstr "Eliin oleva Rosettatable, jos on."

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:7
#: readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:9
msgid "The name of the target file (for split mode)."
msgstr "Lajike tiedoston nimi (pajautumista varten)"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:8
#: readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:10
msgid "The base URL for absolute links."
msgstr "Basurla absoluutilla linkkeen"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:9
#: readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:11
msgid "Whether to append ?raw=true to links."
msgstr "Päästäänko ?raw=true parameterin mukaisesti linkkeihin vai ei?"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:10
msgid "The updated Rosetta table Markdown."
msgstr "Päivitetyt Rossettakorteen Markdown-sivut"

#: of readme_rosetta.markdown_handler.MarkdownHandler.protect_code_blocks:1
msgid "Replaces code blocks with placeholders to prevent translation."
msgstr ""

#: of readme_rosetta.markdown_handler.MarkdownHandler.protect_code_blocks:3
msgid "The Markdown text."
msgstr ""

#: of readme_rosetta.markdown_handler.MarkdownHandler.protect_code_blocks:4
msgid "A tuple containing the protected text and original code blocks."
msgstr "Tupla sisältävä suojattu teksti ja alkuperäiset koodipalo"

#: of readme_rosetta.markdown_handler.MarkdownHandler.restore_code_blocks:1
msgid "Restores code blocks from placeholders after translation."
msgstr ""
"Koodiokselit palautuvat sijaisikohtaisista merkkailuikkoista suomentamisen "
"jälkeen."

#: of readme_rosetta.markdown_handler.MarkdownHandler.restore_code_blocks:3
#: readme_rosetta.sphinx_handler.SphinxHandler.restore_rst:3
msgid "The translated text with placeholders."
msgstr ""
"Täsmällinen käännetty texti: \n"
"{Täsmällinen käännetty teksti}"

#: of readme_rosetta.markdown_handler.MarkdownHandler.restore_code_blocks:4
msgid "The list of original code blocks."
msgstr "Luettelo alkuperäisistä koodiaviokaiteista."

#: of readme_rosetta.markdown_handler.MarkdownHandler.restore_code_blocks:5
msgid "The restored Markdown text."
msgstr "PalautettuMarkdown teksti."

#: of readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:1
msgid "Translates a Markdown file using block-level context."
msgstr "Kääntää Markdown-tiedostoa block-mallilla."

#: of readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:3
msgid "The path to the Markdown file."
msgstr "Reitti Markdown-tiedostoon."

#: of readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:6
msgid "The position of the progress bar."
msgstr "Tiedustemisen kohteena olevan progress barin sijainti."

#: of readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:7
msgid "Whether to simulate translation."
msgstr "Vakaa simuloituksen kääntäminen."

#: of readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:8
msgid "Whether to add the target language name to the first header."
msgstr "Kyllä, katsotaan käyttää suomi-nimiä ensimmäisissä otsikoissa."

#: of readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:12
msgid ""
"A tuple containing (translated_content, rosetta_table, "
"original_content_without_rosetta, identified_first_header)."
msgstr ""
"(kiinteä sisältö, Rosetta-kaartta, alkuperäinen sisältö ilman Rosetta-"
"kaarta, tunnustettu ensimmäinen hakukohde),"

