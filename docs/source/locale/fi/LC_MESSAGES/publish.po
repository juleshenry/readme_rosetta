#: ../../source/publish.rst:2
msgid "publish module"
msgstr "publish module"

#: of publish.get_current_version:1
msgid "Reads the current version from pyproject.toml."
msgstr "Lue nykyinen versio pyproject.toml -tiedostosta."

#: ../../source/publish.rst
msgid "Returns"
msgstr "Palautetaan"

#: of publish.get_current_version:3
msgid "The version string."
msgstr "Versiostringi"

#: of publish.main:1
msgid ""
"Main entry point for the publish script. Increments version, updates files, "
"builds the package, and pushes to git."
msgstr ""
"Pääsyssäkäyttöjärjestelmän julkaisuscriptin pääkayttökohtana. Vähennetään "
"versiota, päivitetään tiedostot, rakennetaan paketti ja noudataan git-"
"merkintäja"

#: of publish.run_command:1
msgid "Runs a shell command and exits if it fails."
msgstr "Säätää käskymänsä käyttöohjelma ja lopettaa jos se epäonnistuu."

#: ../../source/publish.rst
msgid "Parameters"
msgstr ""
"Osaamisen arvo\n"
"Arvonarvioo itselleen olemassa olevien osaisten käytön määrin ja olosuhteiden perusteella. Arvonnassa on huomattava se, että osaistelu ei ole vähintään samanlaiset, vaan erilainen tilanne, jossa osaista voidaan hyötyä paremmin kuin muussa."

#: of publish.run_command:3
msgid "The shell command to run."
msgstr ""
"Sovelluskomenno tulee käyttää komentoriveä, jossa sisältyy seuraavat tiedot:"
" `shell_command` -nimi, joka näytää, mitä komentorivi suorittaa; "
"`input_data`-arvo, joka on tieto, jota komentorivi suoritetaan; "
"`output_path`, joka merkitsee komenorivin tulosta."

#: of publish.run_command:4
msgid "Optional error message to display on failure."
msgstr "Sopivasti virhettömästä tuloksesta näkyvä viesti."

#: of publish.update_changelog:1
msgid "Adds a new entry to the CHANGELOG.md file."
msgstr ""
"Vahvistetaan uuden sovellusversion julkaisu ja lisätään se tietokantaan "
"1.3.0"

#: of publish.update_changelog:3
msgid "The version string to add."
msgstr "Versio-merkintä, jota tulisi lisätä."

#: of publish.update_file:1
msgid "Replaces a pattern in a file with new text."
msgstr "Valtaa korvata patrteri tiedostoon uuden tekstin."

#: of publish.update_file:3
msgid "Path to the file."
msgstr "Tiedoston kanta"

#: of publish.update_file:4
msgid "Regex pattern to search for."
msgstr "Sanaa, joka tähdittää etsintään, on seuraava: `.{4,}`"

#: of publish.update_file:5
msgid "Text to replace the pattern with."
msgstr ""
"Varmistele, että valitsemasi ohjeet ja ominaisuudet on otettu huomioon."
