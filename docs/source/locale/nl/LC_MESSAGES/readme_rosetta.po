#: of readme_rosetta.markdown_handler.MarkdownHandler.clean_header_for_link:1
msgid "Cleans a Markdown header to be used as an anchor link."
msgstr "Schoonmaakt een Markdown-kop als ankerlink gebruikelijk."

#: of readme_rosetta.markdown_handler.MarkdownHandler.clean_header_for_link:3
msgid "The header text."
msgstr "Het hoofdonderwerp"

#: ../../source/readme_rosetta.rst
msgid "Returns"
msgstr "Terugkeert"

#: of readme_rosetta.markdown_handler.MarkdownHandler.clean_header_for_link:4
