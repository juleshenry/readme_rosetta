#: readme_rosetta.translator.Translator.translate_batch:5
msgid "The target language code."
msgstr "Doeltaal: Nederlands"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:6
msgid "The existing Rosetta table, if any."
msgstr "Er bestaat momenteel geen actief gebruik van de oude Rosetta-tabel."

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:7
#: readme_rosetta.markdown_handler.MarkdownHandler.translate_markdown:9
