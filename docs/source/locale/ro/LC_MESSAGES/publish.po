msgid "publish module"
msgstr "Publică modulul."

#: of publish.get_current_version:1
msgid "Reads the current version from pyproject.toml."
msgstr "Citeste actuala versiune din pyproject.toml."

#: ../../source/publish.rst
msgid "Returns"
msgstr "Înapoiează"

#: of publish.get_current_version:3
msgid "The version string."
msgstr "Versiunea de versiune."

#: of publish.main:1
msgid ""
"Main entry point for the publish script. Increments version, updates files, "
"builds the package, and pushes to git."
msgstr ""
"Începutul principale pentru scrisul de publicare. Încrucișește versiunea, "
"updatează fișierele, constrăiește paletele, și trimite la Git."

#: of publish.run_command:1
msgid "Runs a shell command and exits if it fails."
msgstr "Rulă un comand de consolă și iese dacă eșuează."

#: ../../source/publish.rst
msgid "Parameters"
msgstr "Parametrii"

#: of publish.run_command:3
msgid "The shell command to run."
msgstr "Comanda de conștință de sistem pentru a executa."

#: of publish.run_command:4
msgid "Optional error message to display on failure."
msgstr "Mesajul de eroare optional pentru a fi afișat în caz de eșec."

#: of publish.update_changelog:1
msgid "Adds a new entry to the CHANGELOG.md file."
msgstr "Înființează un nov nerecordin în fișierul CHANGELOG.md."

#: of publish.update_changelog:3
msgid "The version string to add."
msgstr "Numele versiunii pentru a adăuga."

#: of publish.update_file:1
msgid "Replaces a pattern in a file with new text."
msgstr "Întreprinde înlocuirea unui patern într-o fișier cu text nou."

#: of publish.update_file:3
