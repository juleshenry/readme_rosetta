msgstr ""
"Lista de coduri de limbă găsite.\n"
"\n"
"* ISO 639-1\n"
"* ISO 639-2\n"
"* ISO 639-3"

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:1
msgid "Generates or updates the Rosetta translation table in the README."
msgstr ""
"Se generează sau se actualizează tabelul de traducție Rosetta în fisierra de"
" citire (README)."

#: of readme_rosetta.markdown_handler.MarkdownHandler.forge_stone:3
msgid "The first header of the document."
msgstr "Prima capatură"

