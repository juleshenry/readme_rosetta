msgid "Scans for existing Sphinx translations in docs/source/locale."
msgstr "扫描 `docs/source/locale` 目录中的已存在的 Sphinx 译文。"

#: of readme_rosetta.sphinx_handler.SphinxHandler.fix_rst_underlines:1
msgid ""
"Ensures rST underlines (===, ---, etc.) are at least as long as the "
"preceding text."
msgstr "确保RST下划线（ ===，---，等等）至少等长于前面的文本。"

#: of readme_rosetta.sphinx_handler.SphinxHandler.fix_rst_underlines:3
#: readme_rosetta.sphinx_handler.SphinxHandler.protect_rst:3
msgid "The rST text."
msgstr ""
"```\n"
".. title:: English to Chinese Translation\n"
".. meta:: English, Chinese\n"
"\n"
"Welcome to our English to Chinese translation service.\n"
"\n"
"Translation Rules\n"
"-----------------\n"
"\n"
"*   The target language is Chinese.\n"
"*   The source language is English.\n"
"*   We will translate the input text precisely from English to Chinese.\n"
"*   We will respond only with the translated text.\n"
"*   We will not add any explanations, notes, or introductions.\n"
"\n"
"Limitations\n"
"------------\n"
"\n"
"*   If we cannot translate something, we will return the original text as is.\n"
"*   If you need a longer description, please provide more context."

#: of readme_rosetta.sphinx_handler.SphinxHandler.fix_rst_underlines:4
msgid "The rST text with fixed underlines."
msgstr ""
