#: of readme_rosetta.markdown_handler.MarkdownHandler.protect_code_blocks:1
msgid "Replaces code blocks with placeholders to prevent translation."
msgstr ""
"**Replaces code blocks com lugares de reemplazo para evitar a tradução**\n"
" \n"
"**`{{ placeholder }}`**"

#: of readme_rosetta.markdown_handler.MarkdownHandler.protect_code_blocks:3
msgid "The Markdown text."
msgstr ""
"**Markdown Text**\n"
"=================\n"
"\n"
"### Headers\n"
"------------\n"
"\n"
"#### Heading 1 (H1)\n"
"This is a first-level heading.\n"
"\n"
"##### Heading 2 (H2)\n"
"This is a second-level heading.\n"
"\n"
"###### Heading 3 (H3)\n"
"This is a third-level heading.\n"
"\n"
"### Lists\n"
"------------\n"
"\n"
"* Item 1\n"
"* Item 2\n"
"* Item 3\n"
"\n"
"#### Ordered List\n"
"1. Item 1\n"
"2. Item 2\n"
"3. Item 3\n"
"\n"
"#### Unordered List with Descriptions\n"
"* Item 1 (Description)\n"
"* Item 2 (Description)\n"
"* Item 3 (Description)\n"
"\n"
"### Links\n"
"-------------\n"
"\n"
"[Link Text](http://example.com \"Link Title\")\n"
"\n"
"### Images\n"
"------------\n"
"\n"
"![Image Alt Text](http://example.com/image.jpg \"Image Title\")"

