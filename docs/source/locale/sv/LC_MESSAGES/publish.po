msgstr "Lägger till en ny inläggning i filen CHANGELOG.md."

#: of publish.update_changelog:3
msgid "The version string to add."
msgstr "För att lägga till en versionssöndring."

#: of publish.update_file:1
msgid "Replaces a pattern in a file with new text."
msgstr "Förvärvar en mönster i ett fil och ersätter det med ny text."

#: of publish.update_file:3
